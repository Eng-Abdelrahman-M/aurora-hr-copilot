# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
# Optional overrides (any OpenAI-compatible provider):
# LLM_API_KEY=            # takes precedence over OPENAI_API_KEY
# LLM_BASE_URL=           # e.g. https://api.groq.com/openai/v1
LLM_MODEL=gpt-4o-mini

# Optional: single-user gate for a public deploy. Open <url>/?token=<value>
# once and a cookie carries the rest of the session. Unset = no auth, which
# is what you want locally.
# APP_TOKEN=
